# Đặt nội dung này trong server block phục vụ thư mục admin/dist.
# `try_files` là bắt buộc để reload/deep-link của Vue Router không trả 404.

root /var/www/pulse-link/admin/dist;
index index.html;

location / {
    try_files $uri $uri/ /index.html;
}

# Cache asset có hash; không cache index để bản deploy mới được nhận ngay.
location ~* ^/assets/.*\.(js|css|png|jpg|jpeg|webp|svg|woff2?)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
}

location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
}
